{
  "name": "atlas-trip-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Atlas \u2014 a cross-platform trip planning workstation (desktop) and travel companion (mobile).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ATLAS_DEV_SERVER=http://localhost:5173 electron electron/main.cjs\"",
    "electron:start": "npm run build && electron electron/main.cjs",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "smoke": "node scripts/smoke.mjs",
    "smoke:shots": "node scripts/smoke.mjs --shots",
    "offline:check": "npm run build && node scripts/offline-check.mjs",
    "verify": "npm run lint && npm run build && npm test && npm run smoke",
    "electron:check": "npm run build && node scripts/electron-check.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/status-bar": "^7.0.6",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}
